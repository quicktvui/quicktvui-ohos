{
  "apiType": "stageMode",
  "buildOptionSet": [
    {
      "name": "release",
      "externalNativeOptions": {
        "abiFilters": [
          "arm64-v8a",
        ],
      },
      "nativeLib": {
        "debugSymbol": {
          "strip": false
        }
      },
      "arkOptions": {
        "obfuscation": {
          "ruleOptions": {
            "enable": false,
            "files": [
              "./obfuscation-rules.txt"
            ]
          }
        }
      },
    },
  ],
  "targets": [
    {
      "name": "default"
    },
    {
      "name": "ohosTest"
    }
  ]
}
