//--------------------------------------------------------------------------------------------
//// --- 1. App 基础信息 (APP_ 前缀) ---
//"APP_ID": "com.test.package",
//"APP_ENTRY": "App",
//"APP_DEBUG": true,          // 比 ENABLE_LOG 更通用
//
//// --- 2. 服务端接口 (API_ 前缀) ---
//"API_HOST": "http://192.168.1.100:8080", // HOST 通常指域名/IP+端口
//"API_VERSION": "/api/v1",                // 版本号分离，拼接更灵活
//
//// --- 3. JS包/动态化配置 (BUNDLE_ 前缀) ---
//"BUNDLE_SOURCE": "LOCAL",                // 取值: 'LOCAL' | 'REMOTE' (比 LOAD_TYPE 更简洁)
//"BUNDLE_URI": "http://192.168.1.100:8080/bundles/game.js", // 远程全路径
//"PARAMS": "{key: value}",
//--------------------------------------------------------------------------------------------

{
  "apiType": "stageMode",
  "buildOption": {
    "externalNativeOptions": {
      "path": "./src/main/cpp/CMakeLists.txt",
      "arguments": "",
      "cppFlags": "",
    }
  },
  "buildOptionSet": [
    {
      "name": "debug",
      "debuggable": true,
      "arkOptions": {
        //会覆盖所有的应用的单独配置项
        "buildProfileFields": {
          "APP_ENTRY": 'Application',
          "APP_DEBUG": true,
          "BUNDLE_SOURCE": 'LOCAL',
          "BUNDLE_URI": 'assets:///vue',
          "PARAMS": '',
        },
        "obfuscation": {
          "ruleOptions": {
            "enable": false,
            "files": [
              "./obfuscation-rules.txt"
            ]
          }
        }
      }
    },
    {
      "name": "release",
      "arkOptions": {
        //会覆盖所有的应用的单独配置项
        "buildProfileFields": {
          "APP_ENTRY": 'Application',
          "APP_DEBUG": false,
          //          "BUNDLE_SOURCE": 'LOCAL',
          //          "BUNDLE_URI": 'assets:///vue',
          "BUNDLE_SOURCE": 'REMOTE',
          "BUNDLE_URI": '',
          "PARAMS": ''
        },
        "obfuscation": {
          "ruleOptions": {
            "enable": false,
            "files": [
              "./obfuscation-rules.txt"
            ]
          }
        }
      }
    }
  ],
  "targets": [
    {
      "name": "default",
    },
    {
      "name": "template",
      "resource": {
        "directories": [
          "./src/main/resources",
          "./src/template/resources"
        ]
      }
    },
    {
      "name": "tudoudou",
      "resource": {
        "directories": [
          "./src/main/resources",
          "./src/tudoudou/resources"
        ]
      }
    },
    {
      "name": "xiangsheng",
      "resource": {
        "directories": [
          "./src/main/resources",
          "./src/xiangsheng/resources"
        ]
      }
    },
    {
      "name": "gushi",
      "resource": {
