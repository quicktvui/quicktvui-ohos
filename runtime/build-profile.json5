//--------------------------------------------------------------------------------------------
//// --- 1. App 基础信息 (APP_ 前缀) ---
//"APP_ID": "com.test.package",//快应用的包名，必须有
//"APP_ENTRY": "",//默认是Application页面，可以指定 Debug
//"APP_DEBUG": true,
//
//// --- 2. JS包/动态化配置 (BUNDLE_ 前缀) ---
//"BUNDLE_URI": "http://192.168.1.100:8080/bundles/game.js",
//默认路径："BUNDLE_URI": '' 默认是服务器端
//远程路径: http://192.168.1.100:8080/bundles/game.js
//本地路径："BUNDLE_URI": 'assets:///vue',

//// --- 3. 参数 ---
//"PARAMS": "{key: value}",//Json数据
//--------------------------------------------------------------------------------------------

{
  "apiType": "stageMode",
  "buildOption": {
    "externalNativeOptions": {
      "path": "./src/main/cpp/CMakeLists.txt",
      "arguments": "",
      "cppFlags": "",
    }
  },
  "buildOptionSet": [
    {
      "name": "debug",
      "debuggable": true,
      "arkOptions": {
        //会覆盖所有的应用的单独配置项
        "buildProfileFields": {
          "APP_DEBUG": true,
        },
        "obfuscation": {
          "ruleOptions": {
            "enable": false,
            "files": [
              "./obfuscation-rules.txt"
            ]
          }
        }
      }
    },
    {
      "name": "release",
      "arkOptions": {
        //会覆盖所有的应用的单独配置项
        "buildProfileFields": {
          "APP_DEBUG": false,
        },
        "obfuscation": {
          "ruleOptions": {
            "enable": false,
            "files": [
              "./obfuscation-rules.txt"
            ]
          }
        }
      }
    }
  ],
  "targets": [
    {
      "name": "default",
    },
    {
      "name": "template",
      "resource": {
        "directories": [
          "./src/main/resources",
          "./src/template/resources"
        ]
      }
    },
    {
      "name": "tudoudou",
      "resource": {
        "directories": [
          "./src/main/resources",
          "./src/tudoudou/resources"
        ]
      }
    },
    {
      "name": "xiangsheng",
      "resource": {
        "directories": [
          "./src/main/resources",
          "./src/xiangsheng/resources"
        ]
      }
    },
